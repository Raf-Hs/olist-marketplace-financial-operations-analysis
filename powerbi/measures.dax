// MarketplaceFinance - DAX measure catalogue
//
// Generated by src/build_powerbi_model.py from the same definitions that
// build the semantic model, so this file and the model cannot disagree.
//
// Modelled measures (marked MODELLED) depend on the rates held in
// DimPaymentMethod. Edit those rates there and every modelled measure
// re-computes - no DAX edit is needed.

// ===== FactOrder =================================================

GMV =
    SUM ( FactOrder[MerchandiseValue] )
    // format: R$#,##0

Cash Collected =
    SUM ( FactOrder[CashCollected] )
    // format: R$#,##0

Freight Collected =
    SUM ( FactOrder[FreightCollected] )
    // format: R$#,##0

Expected Charge =
    SUM ( FactOrder[ExpectedCharge] )
    // format: R$#,##0

Refund Exposure =
    SUM ( FactOrder[RefundExposure] )
    // format: R$#,##0

Net Revenue =
    SUM ( FactOrder[NetRevenue] )
    // format: R$#,##0

Settlement Float =
    SUM ( FactOrder[SettlementFloat] )
    // format: R$#,##0

Voucher Credit =
    SUM ( FactOrder[VoucherValue] )
    // format: R$#,##0

Orders =
    COUNTROWS ( FactOrder[OrderKey] )
    // format: #,##0

Customers =
    DISTINCTCOUNT ( FactOrder[CustomerKey] )
    // format: #,##0

Average Order Value =
    DIVIDE ( [Cash Collected], [Orders] )
    // format: R$#,##0.00

Cash per Customer =
    DIVIDE ( [Cash Collected], [Customers] )
    // format: R$#,##0.00

Revenue vs Expected =
    [Cash Collected] - [Expected Charge]
    // format: R$#,##0

Net Revenue % of Cash =
    DIVIDE ( [Net Revenue], [Cash Collected] )
    // format: 0.00"%"

Refund Exposure Rate =
    DIVIDE ( [Refund Exposure], [Cash Collected] )
    // format: 0.00"%"

Freight Ratio =
    DIVIDE ( [Freight Collected], [GMV] )
    // format: 0.0"%"

Reconciliation Break Orders =
    CALCULATE ( COUNTROWS ( FactOrder[OrderKey] ), FactOrder[ReconBreak] = 1 )
    // format: #,##0

Reconciliation Break Rate =
    DIVIDE ( [Reconciliation Break Orders], [Orders] )
    // format: 0.00"%"

Gross Break Value =
    SUMX ( FILTER ( FactOrder, FactOrder[ReconBreak] = 1 ), ABS ( FactOrder[ReconDelta] ) )
    // format: R$#,##0

Net Break Amount =
    SUMX ( FILTER ( FactOrder, FactOrder[ReconBreak] = 1 ), FactOrder[ReconDelta] )
    // format: R$#,##0

Cash Without Merchandise =
    SUMX ( FILTER ( FactOrder, FactOrder[LineItemCount] = 0 ), FactOrder[CashCollected] )
    // format: R$#,##0

Orders With Reviews =
    CALCULATE ( COUNTROWS ( FactOrder[OrderKey] ), NOT ISBLANK ( FactOrder[WorstReviewScore] ) )
    // format: #,##0

Disputed Orders =
    CALCULATE ( COUNTROWS ( FactOrder[OrderKey] ), FactOrder[DisputedFlag] = 1 )
    // format: #,##0

Dispute Rate =
    DIVIDE ( [Disputed Orders], [Orders With Reviews] )
    // format: 0.0"%"

Disputed Value =
    CALCULATE ( SUM ( FactOrder[CashCollected] ), FactOrder[DisputedFlag] = 1 )
    // format: R$#,##0

Cash at Risk % =
    DIVIDE ( [Disputed Value], [Cash Collected] )
    // format: 0.0"%"

Repeat Customers =
    CALCULATE ( COUNTROWS ( DimCustomer[CustomerKey] ), DimCustomer[IsRepeat] = 1 )
    // format: #,##0

Repeat Customer Rate =
    DIVIDE ( [Repeat Customers], [Customers] )
    // format: 0.00"%"

Orders per Customer =
    DIVIDE ( [Orders], [Customers] )
    // format: #,##0.00

Cash MoM % =
    VAR Prev = CALCULATE ( [Cash Collected], DATEADD ( DimDate[full_date], -1, MONTH ) ) RETURN DIVIDE ( [Cash Collected] - Prev, Prev )
    // format: 0.0"%"

Cash YoY % =
    VAR Prev = CALCULATE ( [Cash Collected], SAMEPERIODLASTYEAR ( DimDate[full_date] ) ) RETURN DIVIDE ( [Cash Collected] - Prev, Prev )
    // format: 0.0"%"

Orders YoY % =
    VAR Prev = CALCULATE ( [Orders], SAMEPERIODLASTYEAR ( DimDate[full_date] ) ) RETURN DIVIDE ( [Orders] - Prev, Prev )
    // format: 0.0"%"

AOV YoY % =
    VAR Prev = CALCULATE ( [Average Order Value], SAMEPERIODLASTYEAR ( DimDate[full_date] ) ) RETURN DIVIDE ( [Average Order Value] - Prev, Prev )
    // format: 0.0"%"

Contribution After Payment Cost =
    [Net Revenue] - [Modelled Total Payment Cost]
    // format: R$#,##0

Contribution Margin % =
    DIVIDE ( [Contribution After Payment Cost], [Net Revenue] )
    // format: 0.0"%"


// ===== FactPayment ===============================================

Payment Value =
    SUM ( FactPayment[PaymentValue] )
    // format: R$#,##0

Payment Rows =
    COUNTROWS ( FactPayment[OrderKey] )
    // format: #,##0

Modelled Acquiring Cost =
    SUMX ( FactPayment, FactPayment[PaymentValue] * RELATED ( DimPaymentMethod[RatePct] ) + RELATED ( DimPaymentMethod[FixedFee] ) )
    // format: R$#,##0

Modelled Installment Funding =
    SUMX ( FactPayment, IF ( FactPayment[PaymentMethodKey] = "credit_card", FactPayment[PaymentValue] * RELATED ( DimPaymentMethod[FundingRatePerInstallment] ) * ( FactPayment[Installments] - 1 ), 0 ) )
    // format: R$#,##0

Modelled Total Payment Cost =
    [Modelled Acquiring Cost] + [Modelled Installment Funding]
    // format: R$#,##0

Value Weighted Average Installments =
    DIVIDE ( SUMX ( FactPayment, FactPayment[Installments] * FactPayment[PaymentValue] ), [Payment Value] )
    // format: #,##0.00

Installment Funded Value =
    SUM ( FactPayment[InstallmentCreditValue] )
    // format: R$#,##0

Voucher Credit (payments) =
    SUM ( FactPayment[VoucherValue] )
    // format: R$#,##0


// ===== FactOrderItem =============================================

Line Items =
    COUNTROWS ( FactOrderItem[OrderItemKey] )
    // format: #,##0

Merchandise Value =
    SUM ( FactOrderItem[Price] )
    // format: R$#,##0

Freight on Items =
    SUM ( FactOrderItem[FreightValue] )
    // format: R$#,##0

Freight Intensity % =
    DIVIDE ( [Freight on Items], [Merchandise Value] )
    // format: 0.0"%"

Items Freight Exceeds Price =
    CALCULATE ( COUNTROWS ( FactOrderItem[OrderItemKey] ), FactOrderItem[FreightOverPrice] = 1 )
    // format: #,##0

Items Freight Exceeds Price % =
    DIVIDE ( [Items Freight Exceeds Price], [Line Items] )
    // format: 0.0"%"


// ===== DimCustomer ===============================================

Customers (dimension) =
    COUNTROWS ( DimCustomer[CustomerKey] )
    // format: #,##0

Repeat Customers (dimension) =
    CALCULATE ( COUNTROWS ( DimCustomer[CustomerKey] ), DimCustomer[IsRepeat] = 1 )
    // format: #,##0


// ===== DimSeller =================================================

Sellers =
    COUNTROWS ( DimSeller[SellerKey] )
    // format: #,##0

Top 1 Seller GMV % =
    DIVIDE ( CALCULATE ( SUM ( DimSeller[SellerGMV] ), DimSeller[GMVRank] = 1 ), [GMV] )
    // format: 0.0"%"

Top 10 Sellers GMV % =
    DIVIDE ( CALCULATE ( SUM ( DimSeller[SellerGMV] ), DimSeller[GMVRank] <= 10 ), [GMV] )
    // format: 0.0"%"

Top 100 Sellers GMV % =
    DIVIDE ( CALCULATE ( SUM ( DimSeller[SellerGMV] ), DimSeller[GMVRank] <= 100 ), [GMV] )
    // format: 0.0"%"

Seller HHI =
    VAR T = [GMV] RETURN SUMX ( DimSeller, DIVIDE ( DimSeller[SellerGMV], T ) ^ 2 )
    // format: 0.00000

Cumulative GMV % =
    VAR r = DimSeller[GMVRank] RETURN DIVIDE ( CALCULATE ( SUM ( DimSeller[SellerGMV] ), FILTER ( ALL ( DimSeller ), DimSeller[GMVRank] <= r ) ), [GMV] )
    // format: 0.0"%"


// ===== DimPaymentMethod ==========================================

Payment Methods =
    COUNTROWS ( DimPaymentMethod[PaymentMethodKey] )
    // format: #,##0

Modelled Acquiring Cost % =
    DIVIDE ( [Modelled Acquiring Cost], [Payment Value] )
    // format: 0.00"%"

