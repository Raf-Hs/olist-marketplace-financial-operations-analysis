          },
          {
            "name": "OrderCount",
            "dataType": "int64",
            "sourceColumn": "OrderCount"
          },
          {
            "name": "ProductCount",
            "dataType": "int64",
            "sourceColumn": "ProductCount"
          },
          {
            "name": "SellerFreight",
            "dataType": "double",
            "sourceColumn": "SellerFreight"
          },
          {
            "name": "FreightRatioPct",
            "dataType": "double",
            "sourceColumn": "FreightRatioPct"
          },
          {
            "name": "AverageOrderValue",
            "dataType": "double",
            "sourceColumn": "AverageOrderValue"
          }
        ],
        "partitions": [
          {
            "name": "DimSeller",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    DataFolder = #\"Data\",\n    Source = Csv.Document(File.Contents(DataFolder & \"\\\\DimSeller.csv\"),[Delimiter=\",\", Columns=10, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"SellerKey\", type text}, {\"SellerState\", type text}, {\"SellerCity\", type text}, {\"GMVRank\", Int64.Type}, {\"SellerGMV\", type number}, {\"OrderCount\", Int64.Type}, {\"ProductCount\", Int64.Type}, {\"SellerFreight\", type number}, {\"FreightRatioPct\", type number}, {\"AverageOrderValue\", type number}}),\n    #\"Sorted Rows\" = Table.Sort(#\"Changed Type\",{{\"SellerKey\", Order.Ascending}})\nin\n    #\"Sorted Rows\""
            }
          }
        ],
        "annotations": [],
        "measures": [
          {
            "name": "Sellers",
            "expression": "COUNTROWS ( DimSeller[SellerKey] )",
            "formatString": "#,##0"
          },
          {
            "name": "Top 1 Seller GMV %",
            "expression": "DIVIDE ( CALCULATE ( SUM ( DimSeller[SellerGMV] ), DimSeller[GMVRank] = 1 ), [GMV] )",
            "formatString": "0.0\"%\""
          },
          {
            "name": "Top 10 Sellers GMV %",
            "expression": "DIVIDE ( CALCULATE ( SUM ( DimSeller[SellerGMV] ), DimSeller[GMVRank] <= 10 ), [GMV] )",
            "formatString": "0.0\"%\""
          },
          {
            "name": "Top 100 Sellers GMV %",
            "expression": "DIVIDE ( CALCULATE ( SUM ( DimSeller[SellerGMV] ), DimSeller[GMVRank] <= 100 ), [GMV] )",
            "formatString": "0.0\"%\""
          },
          {
            "name": "Seller HHI",
            "expression": "VAR T = [GMV] RETURN SUMX ( DimSeller, DIVIDE ( DimSeller[SellerGMV], T ) ^ 2 )",
            "formatString": "0.00000"
          },
          {
            "name": "Cumulative GMV %",
            "expression": "VAR r = DimSeller[GMVRank] RETURN DIVIDE ( CALCULATE ( SUM ( DimSeller[SellerGMV] ), FILTER ( ALL ( DimSeller ), DimSeller[GMVRank] <= r ) ), [GMV] )",
            "formatString": "0.0\"%\""
          }
        ]
      },
