            "sourceColumn": "OrderCount"
          },
          {
            "name": "CashCollected",
            "dataType": "double",
            "sourceColumn": "CashCollected"
          },
          {
            "name": "CustomerGMV",
            "dataType": "double",
            "sourceColumn": "CustomerGMV"
          },
          {
            "name": "RefundExposure",
            "dataType": "double",
            "sourceColumn": "RefundExposure"
          },
          {
            "name": "DisputedOrders",
            "dataType": "int64",
            "sourceColumn": "DisputedOrders"
          },
          {
            "name": "FirstPurchaseDate",
            "dataType": "dateTime",
            "sourceColumn": "FirstPurchaseDate"
          },
          {
            "name": "LastPurchaseDate",
            "dataType": "dateTime",
            "sourceColumn": "LastPurchaseDate"
          },
          {
            "name": "AverageOrderValue",
            "dataType": "double",
            "sourceColumn": "AverageOrderValue"
          },
          {
            "name": "IsRepeat",
            "dataType": "int64",
            "sourceColumn": "IsRepeat"
          },
          {
            "name": "SettlementFloat",
            "dataType": "double",
            "sourceColumn": "SettlementFloat"
          },
          {
            "name": "InstallmentMonths",
            "dataType": "int64",
            "sourceColumn": "InstallmentMonths"
          }
        ],
        "partitions": [
          {
            "name": "DimCustomer",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    DataFolder = #\"Data\",\n    Source = Csv.Document(File.Contents(DataFolder & \"\\\\DimCustomer.csv\"),[Delimiter=\",\", Columns=14, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"CustomerKey\", type text}, {\"CustomerState\", type text}, {\"ZipCodePrefix\", Int64.Type}, {\"OrderCount\", Int64.Type}, {\"CashCollected\", type number}, {\"CustomerGMV\", type number}, {\"RefundExposure\", type number}, {\"DisputedOrders\", Int64.Type}, {\"FirstPurchaseDate\", type date}, {\"LastPurchaseDate\", type date}, {\"AverageOrderValue\", type number}, {\"IsRepeat\", Int64.Type}, {\"SettlementFloat\", type number}, {\"InstallmentMonths\", Int64.Type}}),\n    #\"Sorted Rows\" = Table.Sort(#\"Changed Type\",{{\"CustomerKey\", Order.Ascending}})\nin\n    #\"Sorted Rows\""
            }
          }
        ],
        "annotations": [],
        "measures": [
          {
            "name": "Customers (dimension)",
            "expression": "COUNTROWS ( DimCustomer[CustomerKey] )",
            "formatString": "#,##0"
          },
          {
            "name": "Repeat Customers (dimension)",
            "expression": "CALCULATE ( COUNTROWS ( DimCustomer[CustomerKey] ), DimCustomer[IsRepeat] = 1 )",
            "formatString": "#,##0"
          }
        ]
      },
      {
        "name": "DimSeller",
        "dataCategory": "Dimension",
        "columns": [
