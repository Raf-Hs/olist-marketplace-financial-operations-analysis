          }
        ],
        "partitions": [
          {
            "name": "DimDate",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    DataFolder = #\"Data\",\n    Source = Csv.Document(File.Contents(DataFolder & \"\\\\DimDate.csv\"),[Delimiter=\",\", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    #\"Changed Type\" = Table.TransformColumnTypes(Source,{{\"DateKey\", Int64.Type}, {\"full_date\", type date}, {\"year\", Int64.Type}, {\"MonthNumber\", Int64.Type}, {\"quarter_key\", type text}, {\"month_start\", type date}, {\"day_of_week\", Int64.Type}, {\"is_weekend\", Int64.Type}}),\n    #\"Sorted Rows\" = Table.Sort(#\"Changed Type\",{{\"DateKey\", Order.Ascending}})\nin\n    #\"Sorted Rows\""
            }
          }
        ],
        "annotations": [
          {
            "name": "__PBI_TimeTableEnabled",
            "value": "true"
          }
        ],
        "measures": []
      },
      {
        "name": "DimCustomer",
        "dataCategory": "Dimension",
        "columns": [
          {
            "name": "CustomerKey",
            "dataType": "string",
            "sourceColumn": "CustomerKey",
            "isKey": true
          },
          {
            "name": "CustomerState",
